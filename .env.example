# Local development settings only. Do not put credentials in this file.
STEM_SCI_ENV=development
STEM_SCI_LOG_LEVEL=INFO
STEM_SCI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STEM_SCI_MAX_UPLOAD_BYTES=52428800

# Optional local GPT runtime. Keep STEM_SCI_LLM_API_KEY in the shell or an ignored .env.local.
STEM_SCI_LLM_PROVIDER=gpt
STEM_SCI_LLM_BASE_URL=https://api.openai.com/v1
STEM_SCI_LLM_MODEL=<set-for-local-deployment>
STEM_SCI_LLM_TIMEOUT_SECONDS=60
STEM_SCI_MAX_LLM_CALLS=12
