# ============================================================================
# STEM-SCI 知识图谱模块 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================================

# ── LLM API 凭据（必填，四选一）──────────────────────────────────────

# DeepSeek 4.0（推荐 — JSON 结构化输出最稳定）
# STEM_KB_LLM_API_KEY=sk-your-deepseek-key
# STEM_KB_LLM_API_BASE=http://your-server:port/v1/
# STEM_KB_LLM_MODEL=ds

# Kimi-K2.6（推荐 — 英文文献理解力强）
# STEM_KB_LLM_API_KEY=your-kimi-key
# STEM_KB_LLM_API_BASE=http://your-server:port/v1
# STEM_KB_LLM_MODEL=moonshotai/Kimi-K2.6

# Qwen3.5-397B
# STEM_KB_LLM_API_KEY=your-qwen-key
# STEM_KB_LLM_API_BASE=http://your-server:port/v1
# STEM_KB_LLM_MODEL=Qwen3.5-397B-A17B

# GLM 5.1
# STEM_KB_LLM_API_KEY=your-glm-key
# STEM_KB_LLM_API_BASE=http://your-server:port/v1
# STEM_KB_LLM_MODEL=/models/GLM-5.1-INT8/

# ── Neo4j 连接 ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# ── 校外 fallback（DeepSeek 开放平台免费 500w tokens）────────────────
# STEM_KB_LLM_API_KEY=sk-your-deepseek-key
# STEM_KB_LLM_API_BASE=https://api.deepseek.com/v1
# STEM_KB_LLM_MODEL=deepseek-chat
